#include "resource.h"

IDI_FRAGMENT ICON "fragment.ico"

// The overlay shipped inside the loader, so users download a single file.
// Staged by the PreBuildEvent in the project file (see payload\README.md).
IDR_PAYLOAD RCDATA "payload\\fragment.exe"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "fragment"
            VALUE "FileDescription", "fragment loader"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "fragment"
            VALUE "OriginalFilename", "fragment.exe"
            VALUE "ProductName", "fragment"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
